/* Universal Downloader 2.0.2 - dark gaming style, clean and lightweight */
QMainWindow, QWidget {
    background: #0b0c10;
    color: #e8e8f0;
    font-size: 13px;
}
QFrame#Card {
    background: #11131a;
    border: 1px solid #2a2e3a;
    border-radius: 8px;
}
QLabel {
    color: #e8e8f0;
    background: transparent;
}
QLabel#AppTitle {
    color: #00e5ff;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 1px;
}
QLabel#AppSub {
    color: #8890a8;
    font-size: 12px;
}
QLabel#StatusLabel {
    color: #ff00ff;
    font-weight: bold;
}
QLineEdit {
    background: #161922;
    border: 1px solid #3a4055;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e8e8f0;
}
QLineEdit:focus {
    border: 1px solid #00e5ff;
}
QPushButton {
    background: #161922;
    border: 1px solid #3a4055;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e8e8f0;
    min-width: 70px;
}
QPushButton:hover {
    border: 1px solid #00e5ff;
    background: #1c212d;
}
QPushButton:pressed {
    background: #00e5ff;
    color: #000000;
}
QPushButton:disabled {
    color: #555d70;
    border: 1px solid #2a2e3a;
    background: #11131a;
}
QPushButton#Primary {
    background: #00e5ff;
    color: #000000;
    font-weight: bold;
}
QPushButton#Primary:hover {
    background: #4ff;
}
QPushButton#Danger {
    background: #2a0a15;
    border: 1px solid #5a1a30;
    color: #ff6b8b;
}
QPushButton#Danger:hover {
    border: 1px solid #ff00ff;
}
QPushButton#Ghost {
    border: 1px solid #3a4055;
    color: #a9b1cc;
}
QGroupBox {
    border: 1px solid #2a2e3a;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 10px;
    color: #00e5ff;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background: #0b0c10;
}
QStackedWidget {
    border: none;
    background: transparent;
}
QTableWidget {
    background: #11131a;
    gridline-color: #2a2e3a;
    border: 1px solid #2a2e3a;
    border-radius: 6px;
    selection-background-color: #1c212d;
}
QHeaderView::section {
    background: #161922;
    border: none;
    border-bottom: 1px solid #2a2e3a;
    padding: 5px;
    color: #8890a8;
    font-weight: bold;
}
QProgressBar {
    background: #161922;
    border: 1px solid #3a4055;
    border-radius: 6px;
    text-align: center;
    color: #e8e8f0;
    height: 16px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00e5ff, stop:0.5 #0088ff, stop:1 #ff00ff);
    border-radius: 5px;
}
QComboBox, QSpinBox {
    background: #161922;
    border: 1px solid #3a4055;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e8e8f0;
    min-width: 110px;
}
QComboBox:drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    color: #00e5ff;
}
QRadioButton {
    color: #e8e8f0;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid #3a4055;
    border-radius: 7px;
    background: #161922;
}
QRadioButton::indicator:checked {
    background: #00e5ff;
    border: 1px solid #00e5ff;
}
QCheckBox {
    color: #e8e8f0;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid #3a4055;
    border-radius: 4px;
    background: #161922;
}
QCheckBox::indicator:checked {
    background: #00e5ff;
    border: 1px solid #00e5ff;
}
QTextEdit, QPlainTextEdit {
    background: #0f1117;
    border: 1px solid #2a2e3a;
    border-radius: 6px;
    color: #e8e8f0;
    font-family: monospace;
    font-size: 12px;
}
QStatusBar {
    background: #0a0b0f;
    color: #8890a8;
    border-top: 1px solid #2a2e3a;
}
QDialog {
    background: #0b0c10;
}
